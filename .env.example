# Admin password hash (leave empty to use default password: "admin")
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# JWT secret for admin sessions
JWT_SECRET=your-random-secret-key-change-in-production

# Resend API Key (get from resend.com or set from admin dashboard)
RESEND_API_KEY=
